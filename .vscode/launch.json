{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Meridian extension",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/app-visual-studio",
        "${workspaceFolder}"
      ],
      "outFiles": ["${workspaceFolder}/app-visual-studio/dist/**/*.js"],
      "preLaunchTask": "meridian-extension: compile"
    }
  ]
}
