{
  "name": "meridian-vscode",
  "displayName": "%extension.displayName%",
  "description": "%extension.description%",
  "version": "1.1.27",
  "publisher": "colabcolibri",
  "license": "PolyForm-Noncommercial-1.0.0",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#18181b",
    "theme": "dark"
  },
  "homepage": "https://github.com/colabcolibri/meridian",
  "repository": {
    "type": "git",
    "url": "https://github.com/colabcolibri/meridian"
  },
  "bugs": {
    "url": "https://github.com/colabcolibri/meridian/issues"
  },
  "author": {
    "name": "S. Luciano",
    "url": "https://github.com/colabcolibri"
  },
  "qna": "marketplace",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "AI",
    "Visualization"
  ],
  "keywords": [
    "meridian",
    "meridian harness",
    "harness",
    "agent harness",
    "kanban",
    "user stories",
    "cursor",
    "ai agents",
    "project management",
    "documentation"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onView:meridian.commands",
    "onCommand:meridian.openBoard",
    "onCommand:meridian.openVersions",
    "onCommand:meridian.openSprints",
    "onCommand:meridian.openEpics",
    "onCommand:meridian.openDecisions",
    "onCommand:meridian.openDeliverables",
    "onCommand:meridian.openHelp",
    "onCommand:meridian.openHowToUse",
    "onCommand:meridian.openAgentsHelp",
    "onCommand:meridian.installKit",
    "onCommand:meridian.upgradeKit",
    "onCommand:meridian.validateProject",
    "onCommand:meridian.showStatus",
    "onCommand:meridian.selectActiveProject",
    "workspaceContains:.agent/MERIDIAN.md"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "meridian",
          "title": "%meridian.activitybar.title%",
          "icon": "media/meridian.svg"
        }
      ]
    },
    "views": {
      "meridian": [
        {
          "id": "meridian.commands",
          "name": "%meridian.view.commands.name%"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "meridian.refreshCommands",
          "when": "view == meridian.commands",
          "group": "navigation"
        }
      ],
      "menubar/view": [
        {
          "submenu": "meridian.submenu",
          "group": "7_modification"
        }
      ],
      "meridian.submenu": [
        {
          "command": "meridian.openBoard",
          "group": "1@1"
        },
        {
          "command": "meridian.openVersions",
          "group": "1@2"
        },
        {
          "command": "meridian.openSprints",
          "group": "1@3"
        },
        {
          "command": "meridian.openEpics",
          "group": "1@4"
        },
        {
          "command": "meridian.openDecisions",
          "group": "1@5"
        },
        {
          "command": "meridian.openHowToUse",
          "group": "2@3"
        },
        {
          "command": "meridian.openHelp",
          "group": "2@4"
        },
        {
          "command": "meridian.openStartHere",
          "group": "2@5"
        },
        {
          "command": "meridian.openUsageGuide",
          "group": "2@6"
        },
        {
          "command": "meridian.openAgentsHelp",
          "group": "2@7"
        },
        {
          "command": "meridian.installKit",
          "group": "2@1"
        },
        {
          "command": "meridian.upgradeKit",
          "group": "2@2"
        },
        {
          "command": "meridian.validateProject",
          "group": "3@1"
        },
        {
          "command": "meridian.showStatus",
          "group": "3@2"
        },
        {
          "command": "meridian.selectActiveProject",
          "group": "3@3"
        }
      ]
    },
    "submenus": [
      {
        "id": "meridian.submenu",
        "label": "%meridian.submenu.label%"
      }
    ],
    "commands": [
      {
        "command": "meridian.openBoard",
        "title": "%meridian.command.openBoard.title%",
        "icon": "$(layout)"
      },
      {
        "command": "meridian.openVersions",
        "title": "%meridian.command.openVersions.title%",
        "icon": "$(versions)"
      },
      {
        "command": "meridian.openSprints",
        "title": "%meridian.command.openSprints.title%",
        "icon": "$(run-all)"
      },
      {
        "command": "meridian.openEpics",
        "title": "%meridian.command.openEpics.title%",
        "icon": "$(layers)"
      },
      {
        "command": "meridian.openDecisions",
        "title": "%meridian.command.openDecisions.title%",
        "icon": "$(history)"
      },
      {
        "command": "meridian.openDeliverables",
        "title": "%meridian.command.openDeliverables.title%",
        "icon": "$(list-tree)"
      },
      {
        "command": "meridian.openHelp",
        "title": "%meridian.command.openHelp.title%",
        "icon": "$(symbol-event)"
      },
      {
        "command": "meridian.openHowToUse",
        "title": "%meridian.command.openHowToUse.title%",
        "icon": "$(lightbulb)"
      },
      {
        "command": "meridian.openStartHere",
        "title": "%meridian.command.openStartHere.title%",
        "icon": "$(home)"
      },
      {
        "command": "meridian.openUsageGuide",
        "title": "%meridian.command.openUsageGuide.title%",
        "icon": "$(list-unordered)"
      },
      {
        "command": "meridian.openAgentsHelp",
        "title": "%meridian.command.openAgentsHelp.title%",
        "icon": "$(book)"
      },
      {
        "command": "meridian.installKit",
        "title": "%meridian.command.installKit.title%",
        "icon": "$(cloud-download)"
      },
      {
        "command": "meridian.upgradeKit",
        "title": "%meridian.command.upgradeKit.title%",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "meridian.validateProject",
        "title": "%meridian.command.validateProject.title%",
        "icon": "$(checklist)"
      },
      {
        "command": "meridian.showStatus",
        "title": "%meridian.command.showStatus.title%",
        "icon": "$(info)"
      },
      {
        "command": "meridian.refreshCommands",
        "title": "%meridian.command.refreshCommands.title%",
        "icon": "$(refresh)"
      },
      {
        "command": "meridian.selectActiveProject",
        "title": "%meridian.command.selectActiveProject.title%",
        "icon": "$(list-selection)"
      }
    ],
    "configuration": {
      "title": "Meridian",
      "properties": {
        "meridian.activeProject": {
          "type": "string",
          "default": "",
          "description": "Active Meridian project id from .meridian/projects.json (overrides last picker choice)."
        }
      }
    }
  },
  "scripts": {
    "compile": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "dev": "pnpm watch",
    "build": "pnpm compile",
    "test": "pnpm compile && node --import tsx --test test/**/*.test.ts",
    "package:vsix": "node scripts/bundle-kit.mjs && node esbuild.mjs && vsce package --no-dependencies",
    "publish:marketplace": "node scripts/bundle-kit.mjs && node esbuild.mjs && vsce publish --no-dependencies",
    "publish:marketplace:env": "bash scripts/publish-env.sh",
    "publish:marketplace:patch": "node scripts/bundle-kit.mjs && node esbuild.mjs && vsce publish patch --no-dependencies",
    "install:cursor": "pnpm package:vsix && node scripts/install-vsix.mjs cursor",
    "install:code": "pnpm package:vsix && node scripts/install-vsix.mjs code",
    "vscode:prepublish": "node scripts/bundle-kit.mjs && node esbuild.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.0",
    "typescript": "~5.6.2"
  },
  "dependencies": {
    "yaml": "^2.9.0"
  }
}
